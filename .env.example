# Copy this file to .env.local and fill in a real Postgres connection string.
# Easiest source: Netlify dashboard → your site → Databases → enable Netlify DB
# (this provisions a free Neon Postgres instance and gives you the string).
# Alternatively, create a free database directly at https://neon.tech.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
